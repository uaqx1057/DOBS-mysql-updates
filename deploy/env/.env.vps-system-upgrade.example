# DOBS VPS production profile aligned with VPS_System_Upgrade
# Copy required values into server .env (never commit real secrets)

FLASK_ENV=production
APP_ENV=production
SECRET_KEY=CHANGE_ME

# Keep both forms for compatibility with current config.py
DATABASE_URI=mysql+pymysql://dobs_user:CHANGE_ME@127.0.0.1:3306/dobsykjq_dms
DATABASE_URL=mysql+pymysql://dobs_user:CHANGE_ME@127.0.0.1:3306/dobsykjq_dms

# Redis-backed limiter storage (if enabled in app runtime)
USE_REDIS_RUNTIME=true
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://:CHANGE_ME@127.0.0.1:6379/1

UPLOAD_MAX_MB=16
MAX_CONTENT_LENGTH=16777216

MAIL_SERVER=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_DEFAULT_NAME=DOBS System
MAIL_DEFAULT_ADDRESS=no-reply@yourdomain.com

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
